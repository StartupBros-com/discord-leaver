{
  "name": "bulkleave",
  "version": "1.0.0",
  "type": "module",
  "description": "A CLI tool to bulk leave Discord servers",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "bin": {
    "bulkleave": "./index.js"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*",
      "utils/*"
    ],
    "targets": [
      "node16-linux-x64",
      "node16-macos-x64",
      "node16-win-x64"
    ]
  },
  "keywords": [
    "discord",
    "cli",
    "bulk",
    "leave",
    "server-management"
  ],
  "author": "Danny",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.3.6",
    "ora": "^6.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^2.0.0"
  }
}